{
  "name": "hyperior.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page for Hyperior Limited, a UK joint venture between Kodex Labs Ltd and Atlantic Cedar Limited.",
  "homepage": "https://hyperior.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodexlabsio/hyperior.io.git"
  },
  "author": "Hyperior Limited",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint ${1:-.}",
    "format": "prettier --write --html-whitespace-sensitivity ignore ${1:-.}",
    "format:check": "prettier --check --html-whitespace-sensitivity ignore ${1:-.}",
    "update-dates": "node .kodex/scripts/update-dates.mts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-html-minifier-terser": "^3.8.0"
  }
}
